{
  "name": "spark-work-intake-dashboard",
  "private": true,
  "version": "10.11.0",
  "type": "module",
  "scripts": {
    "test:admin-date": "node tests/admin-order-date.mjs",
    "test:assignment": "node tests/admin-assignment.mjs && node tests/client-assignment.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite --host 0.0.0.0 --preview",
    "test:correction": "node tests/order-correction.mjs",
    "test:member-edit": "node tests/member-order-edit.mjs",
    "test:selection": "node tests/selection-and-managed-client.mjs",
    "test:folders": "node tests/agency-folders.mjs && node tests/agency-folders-client.mjs",
    "test:downline": "node tests/downline-work.mjs && node tests/downline-work-client.mjs",
    "test:performance": "node tests/performance-reads.mjs && node tests/performance-client.mjs",
    "test": "node tests/run-all.mjs",
    "verify": "npm test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.102.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "5.0.0",
    "supabase": "2.115.0",
    "typescript": "5.7.3",
    "vite": "7.0.0"
  }
}
