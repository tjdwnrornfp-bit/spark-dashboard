# 두 값이 비어 있으면 브라우저 localStorage를 사용하는 데모 모드로 실행됩니다.
# Supabase 서버/실시간 동기화를 사용하려면 프로젝트 URL과 Publishable key를 입력하세요.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# 기존 프로젝트에서 legacy anon key를 사용하는 경우 아래 이름도 지원합니다.
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY
